---
import Layout from '../layouts/Layout.astro';
import { pageContent, selectedAssets, siteMeta } from '../data/site';

const home = pageContent.home;
const locationPage = pageContent.location;
const contactPage = pageContent.contact;
---

<Layout title="관리자 화면 데모 | 바인퍼니처" description="바인퍼니처 간편 관리자 MVP가 어떤 범위를 다루는지 설명하는 데모 페이지입니다.">
  <section class="section" style="background: var(--color-surface);">
    <div class="container admin-shell">
      <div class="card admin-hero-card">
        <p class="eyebrow">Admin Demo</p>
        <h1>현재 관리자 MVP에서 다루는 범위</h1>
        <p>
          실제 저장은 <code>/admin</code> 에서 하고, 이 페이지는 운영자에게 어떤 항목을 관리하게 할지 설명하는
          안내용 데모입니다. 핵심은 <strong>자주 바뀌는 정보만 좁게 열어두는 것</strong>입니다.
        </p>
      </div>

      <div class="grid-3">
        <article class="card"><h3>1. 기본 정보</h3><p>전화번호 · 운영시간 · 주소</p></article>
        <article class="card"><h3>2. 외부 링크</h3><p>인스타그램 · 블로그 · 네이버 플레이스</p></article>
        <article class="card"><h3>3. 미리보기 후 반영</h3><p>브라우저 초안 → 페이지 확인 → JSON 반영</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="display:grid; gap:1.25rem;">
      <div class="card">
        <h2>운영자가 직접 바꾸는 항목</h2>
        <div class="grid-3">
          <article class="card"><strong>대표 전화</strong><p>{siteMeta.phone}</p></article>
          <article class="card"><strong>운영시간</strong><p>{siteMeta.hours}</p></article>
          <article class="card"><strong>주소</strong><p>{siteMeta.address}</p></article>
          <article class="card"><strong>인스타그램</strong><p>{siteMeta.instagram}</p></article>
          <article class="card"><strong>블로그</strong><p>{siteMeta.blog}</p></article>
          <article class="card"><strong>네이버 플레이스</strong><p>{siteMeta.place}</p></article>
        </div>
      </div>

      <div class="card">
        <h2>문구 수정 범위</h2>
        <div class="grid-3">
          <article class="card"><h3>메인 제목</h3><p>{home.heroTitle}</p></article>
          <article class="card"><h3>오시는 길 문구</h3><p>{locationPage.heroBody}</p></article>
          <article class="card"><h3>문의 문구</h3><p>{contactPage.heroBody}</p></article>
        </div>
      </div>

      <div class="card">
        <h2>현재 사용 중인 대표 사진 3장</h2>
        <div class="grid-3">
          <article class="card"><img src={selectedAssets.heroPrimary.src} alt={selectedAssets.heroPrimary.alt} /><p style="margin-top:0.75rem;"><strong>메인 대표 사진</strong><br />기본 경로: {selectedAssets.heroPrimary.plannedSrc}</p></article>
          <article class="card"><img src={selectedAssets.storeView.src} alt={selectedAssets.storeView.alt} /><p style="margin-top:0.75rem;"><strong>방문 안내 / 매장 전경 사진</strong><br />기본 경로: {selectedAssets.storeView.plannedSrc}</p></article>
          <article class="card"><img src={selectedAssets.heroSecondary.src} alt={selectedAssets.heroSecondary.alt} /><p style="margin-top:0.75rem;"><strong>문의 보조 사진</strong><br />기본 경로: {selectedAssets.heroSecondary.plannedSrc}</p></article>
        </div>
      </div>

      <div class="card">
        <h2>최근 사진 영역 운영 방식</h2>
        <p class="note">현재 홈의 최근 사진 영역은 사이트 관리자에서 따로 순서/노출을 바꾸지 않고, 인스타그램 피드 업데이트를 그대로 따라갑니다.</p>
        <div class="grid-3" style="margin-top:1rem;">
          <article class="card"><h3>사이트 관리자에서 하는 일</h3><p>전화, 운영시간, 주소, 문구, 현재 쓰는 대표 사진만 수정</p></article>
          <article class="card"><h3>최근 사진은 어디서 바꾸나</h3><p>인스타그램 계정에서 게시물 업로드/정리로 관리</p></article>
          <article class="card"><h3>홈에서 보이는 방식</h3><p>홈 최근 사진 섹션에서 인스타그램 최신 흐름을 바로 확인</p></article>
        </div>
      </div>

      <div class="grid-3">
        <article class="card"><h3>초안 저장</h3><p>브라우저 localStorage에 자동 저장</p></article>
        <article class="card"><h3>미리보기</h3><p>메인 / 오시는 길 / 문의 페이지에 draft 파라미터로 반영</p></article>
        <article class="card"><h3>사이트 반영</h3><p><code>vine-admin-publish.json</code> 생성 후 import 스크립트로 적용</p></article>
      </div>
    </div>
  </section>
</Layout>
