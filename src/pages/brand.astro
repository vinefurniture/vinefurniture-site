---
import Layout from '../layouts/Layout.astro';
import { pageContent, selectedAssets } from '../data/site';

const brand = pageContent.brand;
const brandHeroAsset = selectedAssets.storeView;
---

<Layout
  title={brand.title}
  description={brand.description}
>
  <section class="section">
    <div class="container two-column">
      <div>
        <p class="eyebrow">{brand.eyebrow}</p>
        <h1>{brand.heroTitle}</h1>
        <p>{brand.heroBody}</p>
      </div>
      <div class="card-image-wrap hero-media-small">
        <img src={brandHeroAsset.src} alt={brandHeroAsset.alt} />
        <div class="overlay-note">브랜드 소개 대표 이미지</div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <h2>{brand.valuesTitle}</h2>
      <div class="grid-4">
        {brand.values.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-panel">
        <div>
          <p class="eyebrow">Brand Guide</p>
          <h2>핵심 사진과 방문 안내는 홈에서 더 빠르게 확인하실 수 있습니다.</h2>
          <p>브랜드 소개 페이지는 바인퍼니처의 기준을 짧게 확인하는 보조 페이지로 두고, 실제 사진 확인과 방문 문의 흐름은 홈 중심으로 정리했습니다.</p>
        </div>
        <div class="button-group cta-panel-actions">
          <a class="button" href="/#recent-feed">최근 사진 보기</a>
          <a class="button secondary" href="/#visit">방문 예약 보기</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
