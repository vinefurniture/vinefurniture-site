---
import Layout from '../layouts/Layout.astro';
import { galleryAssets, pageContent, selectedAssets, siteMeta } from '../data/site';

const home = pageContent.home;
const homeGalleryAssets = galleryAssets.slice(0, 4);
const homePromo = home.promo;
const instagramProfileUrl = siteMeta.instagram.replace(/\/$/, '');
const instagramEmbedUrl = `${instagramProfileUrl}/embed/`;
---

<Layout
  title={home.title}
  description={home.description}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{home.eyebrow}</p>
        <h1 data-draft-field="home.heroTitle">{home.heroTitle}</h1>
        <p data-draft-field="home.heroBody">{home.heroBody}</p>
        <div class="button-group">
          <a class="button" href={home.heroPrimaryCtaHref} data-draft-href="business.phoneHref">{home.heroPrimaryCtaLabel}</a>
          <a class="button secondary" href={home.heroSecondaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.place">{home.heroSecondaryCtaLabel}</a>
        </div>
      </div>

      <div class="hero-media card-image-wrap hero-media-large">
        <img src={selectedAssets.heroPrimary.src} alt={selectedAssets.heroPrimary.alt} data-draft-image="heroPrimary" />
        <div class="overlay-note">대표 침대 쇼룸 이미지</div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container two-column">
      <div>
        <h2>{home.aboutTitle}</h2>
        <p>{home.aboutBody}</p>
      </div>
      <div class="info-box">
        <h3>{home.infoTitle}</h3>
        <ul class="simple-list">
          <li>주소: <span data-draft-field="business.address">{siteMeta.address}</span></li>
          <li>운영시간: <span data-draft-field="business.hours">{siteMeta.hours}</span></li>
          <li>대표번호: <span data-draft-field="business.phone">{siteMeta.phone}</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);" id="strengths">
    <div class="container">
      <h2>{home.strengthTitle}</h2>
      <div class="grid-4">
        {home.strengths.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section" id="home-gallery">
    <div class="container">
      <h2>{home.galleryTitle}</h2>
      <p class="note">{home.galleryNote}</p>
      <div class="grid-4 gallery-grid" style="margin-top:1.5rem;" data-draft-gallery-container="home" data-draft-gallery-limit="4">
        {homeGalleryAssets.map((asset) => (
          <article class="gallery-card home-gallery-item" data-draft-gallery-item={asset.key}>
            <div class="card-image-wrap">
              <img src={asset.src} alt={asset.alt} />
            </div>
            <div class="gallery-copy">
              <strong>{asset.title}</strong>
              <span>{asset.category}</span>
            </div>
          </article>
        ))}
      </div>

      <section class="instagram-feed-panel instagram-feed-panel--compact" aria-labelledby="recent-feed-title" id="recent-feed">
        <div class="instagram-feed-copy">
          <p class="eyebrow">{home.recentFeedEyebrow}</p>
          <h2 id="recent-feed-title">{home.recentFeedTitle}</h2>
          <p class="note">{home.recentFeedBody}</p>
          <div class="button-group instagram-feed-actions">
            <a class="button secondary" href={home.recentFeedPrimaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.instagram">{home.recentFeedPrimaryCtaLabel}</a>
          </div>
        </div>

        <div class="instagram-feed-frame-wrap instagram-feed-frame-wrap--compact">
          <iframe
            class="instagram-feed-frame instagram-feed-frame--compact"
            src={instagramEmbedUrl}
            title="바인퍼니처 인스타그램 최근 피드"
            loading="lazy"
            allowtransparency="true"
          />
        </div>
      </section>
    </div>
  </section>

  {homePromo?.enabled !== false && (
    <section class="section home-promo-section" data-draft-toggle="homePromo.enabled" id="visit-promo">
      <div class="container">
        <article class="cta-panel home-promo-panel">
          <div class="home-promo-copy">
            <p class="eyebrow" data-draft-field="homePromo.eyebrow">{homePromo?.eyebrow}</p>
            <h2 data-draft-field="homePromo.title">{homePromo?.title}</h2>
            <p class="note home-promo-note" data-draft-field="homePromo.body">{homePromo?.body}</p>
            {homePromo?.benefit && <p class="home-promo-benefit">{homePromo.benefit}</p>}
            {homePromo?.disclaimer && <p class="note home-promo-disclaimer">{homePromo.disclaimer}</p>}
          </div>
          <div class="button-group cta-panel-actions home-promo-actions">
            <a class="button" href={home.visitPrimaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.place">네이버 플레이스로 방문 예약</a>
            <a class="button secondary" href={home.heroPrimaryCtaHref} data-draft-href="business.phoneHref">전화 문의하기</a>
          </div>
        </article>
      </div>
    </section>
  )}

  <section class="section" style="background: var(--color-surface);" id="visit">
    <div class="container two-column">
      <div>
        <h2>{home.visitTitle}</h2>
        <p>{home.visitBody}</p>
        <div class="button-group">
          <a class="button" href={home.visitPrimaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.place">{home.visitPrimaryCtaLabel}</a>
          <a class="button secondary" href={home.visitSecondaryCtaHref} data-draft-href="business.phoneHref">{home.visitSecondaryCtaLabel}</a>
        </div>
      </div>
      <div class="card-image-wrap hero-media-small">
        <img src={selectedAssets.storeView.src} alt={selectedAssets.storeView.alt} data-draft-image="storeView" />
        <div class="overlay-note">매장 외관 대표 이미지</div>
      </div>
    </div>
  </section>
</Layout>
