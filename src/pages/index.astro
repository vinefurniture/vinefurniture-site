---
import Layout from '../layouts/Layout.astro';
import { pageContent, selectedAssets, siteMeta } from '../data/site';

const home = pageContent.home;
const homePromo = home.promo;
const instagramEmbedUrl = `${siteMeta.instagram.replace(/\/$/, '')}/embed/`;
const visitLeadEyebrow = homePromo?.eyebrow ?? '방문 안내';
const visitLeadTitle = homePromo?.enabled !== false && homePromo?.title ? homePromo.title : home.visitTitle;
const visitLeadBody = homePromo?.enabled !== false && homePromo?.body ? homePromo.body : home.visitBody;
---

<Layout
  title={home.title}
  description={home.description}
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{home.eyebrow}</p>
        <h1 data-draft-field="home.heroTitle">{home.heroTitle}</h1>
        <p data-draft-field="home.heroBody">{home.heroBody}</p>
        {home.heroTrustLine && <p class="hero-trust-line">{home.heroTrustLine}</p>}
        <div class="button-group">
          <a class="button" href={home.heroPrimaryCtaHref} data-draft-href="business.phoneHref" data-analytics-event="click_call" data-analytics-label="home_hero_call">{home.heroPrimaryCtaLabel}</a>
          <a class="button secondary" href={home.heroSecondaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.place" data-analytics-event="click_naver_place" data-analytics-label="home_hero_naver_place">{home.heroSecondaryCtaLabel}</a>
        </div>
      </div>

      <div class="hero-media card-image-wrap hero-media-large">
        <img src={selectedAssets.heroPrimary.src} alt={selectedAssets.heroPrimary.alt} data-draft-image="heroPrimary" fetchpriority="high" />
        <div class="overlay-note">대표 침대 쇼룸 이미지</div>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container two-column">
      <div>
        <h2>{home.aboutTitle}</h2>
        <p>{home.aboutBody}</p>
      </div>
      <div class="info-box">
        <h3>{home.infoTitle}</h3>
        <ul class="simple-list">
          <li>주소: <span data-draft-field="business.address">{siteMeta.address}</span></li>
          <li>운영시간: <span data-draft-field="business.hours">{siteMeta.hours}</span></li>
          <li>대표번호: <span data-draft-field="business.phone">{siteMeta.phone}</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);" id="strengths">
    <div class="container">
      <h2>{home.strengthTitle}</h2>
      <div class="grid-4">
        {home.strengths.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);" id="visit">
    <div class="container">
      <article class="visit-highlight-panel" data-draft-toggle="homePromo.enabled">
        <div class="visit-highlight-copy">
          <p class="eyebrow" data-draft-field="homePromo.eyebrow">{visitLeadEyebrow}</p>
          <h2 data-draft-field="homePromo.title">{visitLeadTitle}</h2>
          <p class="note visit-highlight-note" data-draft-field="homePromo.body">{visitLeadBody}</p>
          {homePromo?.benefit && <p class="home-promo-benefit">{homePromo.benefit}</p>}
          {homePromo?.disclaimer && <p class="note home-promo-disclaimer">{homePromo.disclaimer}</p>}
          <div class="button-group visit-highlight-actions">
            <a class="button" href={home.visitPrimaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.place" data-analytics-event="click_naver_place" data-analytics-label="home_visit_naver_place">{home.visitPrimaryCtaLabel}</a>
            <a class="button secondary" href={home.visitSecondaryCtaHref} data-draft-href="business.phoneHref" data-analytics-event="click_call" data-analytics-label="home_visit_call">{home.visitSecondaryCtaLabel}</a>
          </div>
        </div>

        <div class="card-image-wrap hero-media-small visit-highlight-media">
          <img src={selectedAssets.storeView.src} alt={selectedAssets.storeView.alt} data-draft-image="storeView" loading="lazy" />
          <div class="overlay-note">매장 외관 대표 이미지</div>
        </div>
      </article>
    </div>
  </section>

  <section class="section instagram-bottom-section" id="recent-feed">
    <div class="container">
      <div class="recent-feed-section-head">
        <div class="recent-feed-intro">
          <p class="eyebrow">{home.recentFeedEyebrow}</p>
          <h2>{home.galleryTitle}</h2>
        </div>
        <div class="button-group recent-feed-actions">
          <a class="button secondary" href={home.recentFeedPrimaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.instagram" data-analytics-event="click_instagram" data-analytics-label="home_bottom_instagram">{home.recentFeedPrimaryCtaLabel}</a>
          <a class="button" href={home.visitPrimaryCtaHref} target="_blank" rel="noreferrer" data-draft-href="business.place" data-analytics-event="click_naver_place" data-analytics-label="home_bottom_naver_place">{home.visitPrimaryCtaLabel}</a>
        </div>
      </div>

      <div class="instagram-feed-embed-shell">
        <div class="instagram-feed-frame-wrap instagram-feed-frame-wrap--home">
          <iframe
            class="instagram-feed-frame instagram-feed-frame--home"
            src={instagramEmbedUrl}
            title="바인퍼니처 인스타그램 최근 피드"
            loading="lazy"
            allowtransparency="true"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>
