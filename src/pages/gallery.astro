---
import Layout from '../layouts/Layout.astro';
import { galleryAssets, pageContent, siteMeta } from '../data/site';

const galleryPage = pageContent.gallery;
const categoryLabels = [...new Set(galleryAssets.map((asset) => asset.category).filter(Boolean))];
const instagramProfileUrl = siteMeta.instagram.replace(/\/$/, '');
const instagramEmbedUrl = `${instagramProfileUrl}/embed/`;
const galleryPreviewAssets = galleryAssets.slice(0, 6);
---

<Layout
  title={galleryPage.title}
  description={galleryPage.description}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{galleryPage.eyebrow}</p>
      <h1>{galleryPage.heroTitle}</h1>
      <p class="note">{galleryPage.heroNote}</p>

      <div class="gallery-summary-grid">
        <article class="gallery-summary-card">
          <span class="gallery-summary-label">운영 방식</span>
          <strong>인스타 피드 중심</strong>
          <p>최신 사진은 인스타그램에서 먼저 올리고, 이 페이지에서는 그 흐름을 바로 확인하실 수 있게 정리했습니다.</p>
        </article>

        <article class="gallery-summary-card gallery-summary-card--wide">
          <span class="gallery-summary-label">사진에서 먼저 확인할 수 있는 것</span>
          <div class="chip-row">
            {categoryLabels.map((label) => <span class="chip">{label}</span>)}
          </div>
          <p>침대, 소파, 식탁, 매장 분위기를 먼저 살펴보시고 마음에 드는 스타일이 있으면 바로 문의하실 수 있습니다.</p>
        </article>
      </div>

      <section class="instagram-feed-panel" aria-labelledby="instagram-feed-title">
        <div class="instagram-feed-copy">
          <p class="eyebrow">Instagram Feed</p>
          <h2 id="instagram-feed-title">최근 사진은 여기서 바로 확인해보세요.</h2>
          <p class="note">새 사진은 인스타그램에 먼저 올리고, 이 페이지에서는 같은 흐름을 바로 볼 수 있게 구성했습니다. 마음에 드는 스타일이 보이면 방문 예약이나 전화 문의로 이어가시면 됩니다.</p>
          <div class="button-group instagram-feed-actions">
            <a class="button" href={instagramProfileUrl} target="_blank" rel="noreferrer" data-draft-href="business.instagram">인스타그램에서 직접 열기</a>
            <a class="button secondary" href={siteMeta.place} target="_blank" rel="noreferrer" data-draft-href="business.place">네이버 플레이스로 방문 예약</a>
          </div>
        </div>

        <div class="instagram-feed-frame-wrap">
          <iframe
            class="instagram-feed-frame"
            src={instagramEmbedUrl}
            title="바인퍼니처 인스타그램 피드"
            loading="lazy"
            allowtransparency="true"
          />
        </div>
      </section>

      <section class="gallery-secondary-block" aria-labelledby="gallery-curated-title">
        <div class="gallery-secondary-head">
          <p class="eyebrow">Showroom Highlights</p>
          <h2 id="gallery-curated-title">대표 쇼룸 사진도 함께 확인해보세요.</h2>
          <p class="note">인스타 피드 아래에는 상담 때 자주 보여드리는 대표 컷만 간단히 정리해두었습니다.</p>
        </div>

        <div class="grid-4 gallery-grid gallery-grid-secondary" data-draft-gallery-container="gallery">
          {galleryPreviewAssets.map((asset) => (
            <article class="gallery-card" data-draft-gallery-item={asset.key}>
              <div class="card-image-wrap">
                <img src={asset.src} alt={asset.alt} />
              </div>
              <div class="gallery-copy">
                <strong>{asset.title}</strong>
                <span>{asset.category}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <div class="cta-panel" style="margin-top:2.25rem;">
        <div>
          <p class="eyebrow">Visit & Contact</p>
          <h2>마음에 드는 스타일이 보이셨다면 편하게 문의해주세요.</h2>
          <p>실제 가구의 크기감, 소재감, 색상은 매장에서 직접 보실 때 더 정확하게 확인하실 수 있습니다.</p>
        </div>
        <div class="button-group cta-panel-actions">
          <a class="button" href={siteMeta.phoneHref} data-draft-href="business.phoneHref">전화 문의하기</a>
          <a class="button secondary" href={siteMeta.place} target="_blank" rel="noreferrer" data-draft-href="business.place">네이버 플레이스로 방문 예약</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
