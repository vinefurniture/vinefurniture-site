---
import Layout from '../layouts/Layout.astro';
import { galleryAssets, pageContent, siteMeta } from '../data/site';

const galleryPage = pageContent.gallery;
const categoryLabels = [...new Set(galleryAssets.map((asset) => asset.category).filter(Boolean))];
---

<Layout
  title={galleryPage.title}
  description={galleryPage.description}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{galleryPage.eyebrow}</p>
      <h1>{galleryPage.heroTitle}</h1>
      <p class="note">{galleryPage.heroNote}</p>

      <div class="gallery-summary-grid">
        <article class="gallery-summary-card">
          <span class="gallery-summary-label">대표 이미지</span>
          <strong>{galleryAssets.length}장</strong>
          <p>침대, 소파, 식탁, 쇼룸 전경까지 주요 이미지를 먼저 확인하실 수 있습니다.</p>
        </article>

        <article class="gallery-summary-card gallery-summary-card--wide">
          <span class="gallery-summary-label">주요 카테고리</span>
          <div class="chip-row">
            {categoryLabels.map((label) => <span class="chip">{label}</span>)}
          </div>
          <p>사진으로 분위기를 먼저 확인하시고, 자세한 구성은 매장 방문 또는 전화 상담으로 이어서 안내해드립니다.</p>
        </article>
      </div>

      <div class="grid-4 gallery-grid" style="margin-top:2rem;">
        {galleryAssets.map((asset) => (
          <article class="gallery-card">
            <div class="card-image-wrap">
              <img src={asset.src} alt={asset.alt} />
            </div>
            <div class="gallery-copy">
              <strong>{asset.title}</strong>
              <span>{asset.category}</span>
            </div>
          </article>
        ))}
      </div>

      <div class="cta-panel" style="margin-top:2.25rem;">
        <div>
          <p class="eyebrow">Visit & Contact</p>
          <h2>마음에 드는 스타일이 보이셨다면 편하게 문의해주세요.</h2>
          <p>실제 가구의 크기감, 소재감, 색상은 매장에서 직접 보실 때 더 정확하게 확인하실 수 있습니다.</p>
        </div>
        <div class="button-group cta-panel-actions">
          <a class="button" href={siteMeta.phoneHref}>전화 문의하기</a>
          <a class="button secondary" href="/location">오시는 길 보기</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
