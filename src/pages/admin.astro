---
import Layout from '../layouts/Layout.astro';
import { pageContent, selectedAssets, siteMeta } from '../data/site';

const adminDefaults = {
  business: {
    phone: siteMeta.phone,
    phoneHref: siteMeta.phoneHref,
    address: siteMeta.address,
    hours: siteMeta.hours,
  },
  home: {
    heroTitle: pageContent.home.heroTitle,
    heroBody: pageContent.home.heroBody,
  },
  locationPage: {
    heroBody: pageContent.location.heroBody,
  },
  contactPage: {
    heroBody: pageContent.contact.heroBody,
  },
  assetSlots: {
    heroPrimary: selectedAssets.heroPrimary.src,
    heroSecondary: selectedAssets.heroSecondary.src,
    storeView: selectedAssets.storeView.src,
  },
};
---

<Layout title="간편 관리자 | 바인퍼니처" description="바인퍼니처 운영자가 자주 바꾸는 정보만 안전하게 다루는 간편 관리자 MVP입니다.">
  <section class="section" style="background: var(--color-surface);">
    <div class="container admin-shell">
      <div class="card admin-hero-card">
        <p class="eyebrow">Simple Admin</p>
        <h1>쉽게 수정하는 바인퍼니처 관리자</h1>
        <p>
          이 화면에서는 <strong>전화번호, 운영시간, 주소, 메인 문구, 대표 사진 3장</strong>만 바꿉니다.
          어려운 설정은 숨기고, 자주 쓰는 항목만 남겼습니다.
        </p>

        <div class="admin-step-strip">
          <article class="admin-step-card">
            <strong>1. 내용 수정</strong>
            <p>아래 칸을 바꾸면 자동 저장됩니다.</p>
          </article>
          <article class="admin-step-card">
            <strong>2. 미리보기 확인</strong>
            <p>버튼을 눌러 사이트 화면을 새 탭에서 봅니다.</p>
          </article>
          <article class="admin-step-card">
            <strong>3. 최종 반영</strong>
            <p>확정된 내용만 실제 사이트에 옮기면 됩니다.</p>
          </article>
        </div>
      </div>

      <div class="card admin-action-bar">
        <div class="admin-status-row">
          <div>
            <strong>저장 상태</strong>
            <p id="admin-status" class="note admin-status-text">기본값을 불러왔습니다.</p>
          </div>
          <span id="admin-status-badge" class="admin-status-badge is-saved">자동 저장됨</span>
        </div>

        <div class="button-group admin-action-buttons admin-action-buttons-primary">
          <button type="button" class="button" id="open-home-preview">메인 화면 보기</button>
          <button type="button" class="button secondary" id="open-location-preview">오시는 길 보기</button>
          <button type="button" class="button secondary" id="open-contact-preview">문의 화면 보기</button>
        </div>

        <details class="admin-more-actions">
          <summary>추가 작업 열기</summary>
          <div class="button-group admin-action-buttons admin-action-buttons-secondary">
            <button type="button" class="button secondary" id="save-draft">지금 저장</button>
            <button type="button" class="button secondary" id="export-draft">JSON 내보내기</button>
            <button type="button" class="button secondary" id="reset-draft">처음 상태로 되돌리기</button>
          </div>
          <p class="note">초안은 현재 브라우저에만 저장됩니다.</p>
        </details>
      </div>

      <div class="admin-grid">
        <form id="admin-form" class="admin-form" autocomplete="off">
          <section class="card admin-section-card">
            <div class="admin-section-head">
              <h2>1. 매장 기본 정보</h2>
              <p class="note">전화번호와 운영시간은 고객이 가장 자주 보는 정보입니다.</p>
            </div>
            <div class="grid-3">
              <label class="admin-field">
                <span>대표 전화</span>
                <input name="business.phone" type="text" inputmode="tel" />
                <small>예: 031-312-1051</small>
              </label>
              <label class="admin-field">
                <span>운영시간</span>
                <input name="business.hours" type="text" />
                <small>예: 매일 10:00~19:00</small>
              </label>
              <label class="admin-field">
                <span>주소</span>
                <input name="business.address" type="text" />
                <small>지번/건물층까지 한 줄로 적어주세요.</small>
              </label>
            </div>
          </section>

          <section class="card admin-section-card">
            <div class="admin-section-head">
              <h2>2. 메인 화면 문구</h2>
              <p class="note">첫 화면에서 보이는 핵심 소개 문구입니다.</p>
            </div>
            <div style="display:grid; gap:1rem;">
              <label class="admin-field">
                <span>메인 제목</span>
                <textarea name="home.heroTitle" rows="3"></textarea>
                <small>너무 길지 않게 한 문장으로 적는 것이 좋습니다.</small>
              </label>
              <label class="admin-field">
                <span>메인 소개문</span>
                <textarea name="home.heroBody" rows="5"></textarea>
                <small>매장 강점과 방문 유도를 짧게 적어주세요.</small>
              </label>
            </div>
          </section>

          <section class="card admin-section-card">
            <div class="admin-section-head">
              <h2>3. 안내 문구</h2>
              <p class="note">오시는 길과 문의 페이지에 들어가는 소개 문구입니다.</p>
            </div>
            <div style="display:grid; gap:1rem;">
              <label class="admin-field">
                <span>오시는 길 소개문</span>
                <textarea name="locationPage.heroBody" rows="4"></textarea>
              </label>
              <label class="admin-field">
                <span>문의 페이지 소개문</span>
                <textarea name="contactPage.heroBody" rows="4"></textarea>
              </label>
            </div>
          </section>

          <section class="card admin-section-card">
            <div class="admin-section-head">
              <h2>4. 대표 사진 3장</h2>
              <p class="note">사진을 고르면 바로 이 화면에서 미리 바뀌고, 자동 저장됩니다.</p>
            </div>
            <div class="admin-image-grid">
              <article class="card admin-image-card">
                <img src={selectedAssets.heroPrimary.src} alt={selectedAssets.heroPrimary.alt} data-admin-preview="heroPrimary" />
                <div>
                  <strong>메인 대표 사진</strong>
                  <p class="note">첫 화면 가장 큰 사진</p>
                  <input type="file" accept="image/*" data-admin-file="heroPrimary" />
                  <button type="button" class="button secondary admin-clear-image" data-admin-clear="heroPrimary">기본 사진으로 되돌리기</button>
                </div>
              </article>
              <article class="card admin-image-card">
                <img src={selectedAssets.storeView.src} alt={selectedAssets.storeView.alt} data-admin-preview="storeView" />
                <div>
                  <strong>매장 전경 사진</strong>
                  <p class="note">브랜드 소개 / 오시는 길에 사용</p>
                  <input type="file" accept="image/*" data-admin-file="storeView" />
                  <button type="button" class="button secondary admin-clear-image" data-admin-clear="storeView">기본 사진으로 되돌리기</button>
                </div>
              </article>
              <article class="card admin-image-card">
                <img src={selectedAssets.heroSecondary.src} alt={selectedAssets.heroSecondary.alt} data-admin-preview="heroSecondary" />
                <div>
                  <strong>문의 보조 사진</strong>
                  <p class="note">문의 페이지에 들어가는 사진</p>
                  <input type="file" accept="image/*" data-admin-file="heroSecondary" />
                  <button type="button" class="button secondary admin-clear-image" data-admin-clear="heroSecondary">기본 사진으로 되돌리기</button>
                </div>
              </article>
            </div>
          </section>
        </form>

        <aside class="admin-side-column">
          <section class="card admin-summary-card">
            <h2>지금 바뀌는 내용</h2>
            <div class="admin-summary-block">
              <strong>전화번호</strong>
              <p id="summary-phone"></p>
            </div>
            <div class="admin-summary-block">
              <strong>운영시간</strong>
              <p id="summary-hours"></p>
            </div>
            <div class="admin-summary-block">
              <strong>주소</strong>
              <p id="summary-address"></p>
            </div>
            <div class="admin-summary-block">
              <strong>메인 제목</strong>
              <p id="summary-home-title"></p>
            </div>
            <div class="admin-summary-block">
              <strong>문의 안내문</strong>
              <p id="summary-contact-body"></p>
            </div>
          </section>

          <section class="card admin-summary-card">
            <h2>간단 사용 팁</h2>
            <ol class="simple-list note">
              <li>먼저 전화번호와 운영시간부터 수정</li>
              <li>그다음 메인 제목과 소개문 확인</li>
              <li>마지막으로 사진 3장만 교체</li>
              <li>미리보기로 확인 후 확정본만 반영</li>
            </ol>
          </section>
        </aside>
      </div>
    </div>
  </section>

  <script define:vars={{ adminDefaults }}>
    const DRAFT_KEY = 'vine-admin-draft-v1';
    const defaults = JSON.parse(JSON.stringify(adminDefaults));

    const clone = (value) => JSON.parse(JSON.stringify(value));
    const form = document.querySelector('#admin-form');
    const statusEl = document.querySelector('#admin-status');
    const statusBadgeEl = document.querySelector('#admin-status-badge');
    let saveTimer = null;

    const pathGet = (obj, path) => path.split('.').reduce((acc, key) => acc?.[key], obj);
    const pathSet = (obj, path, value) => {
      const keys = path.split('.');
      const last = keys.pop();
      const target = keys.reduce((acc, key) => {
        if (!acc[key] || typeof acc[key] !== 'object') acc[key] = {};
        return acc[key];
      }, obj);
      target[last] = value;
    };

    const makePhoneHref = (phone) => `tel:${String(phone ?? '').replace(/[^0-9+]/g, '')}`;

    const mergeDeep = (base, incoming) => ({
      ...base,
      ...incoming,
      business: { ...base.business, ...(incoming?.business || {}) },
      home: { ...base.home, ...(incoming?.home || {}) },
      locationPage: { ...base.locationPage, ...(incoming?.locationPage || {}) },
      contactPage: { ...base.contactPage, ...(incoming?.contactPage || {}) },
      assetSlots: { ...base.assetSlots, ...(incoming?.assetSlots || {}) },
    });

    const readDraft = () => {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        return raw ? mergeDeep(clone(defaults), JSON.parse(raw)) : clone(defaults);
      } catch {
        return clone(defaults);
      }
    };

    let state = readDraft();

    const setSavedState = (saved) => {
      statusBadgeEl.textContent = saved ? '자동 저장됨' : '저장 중';
      statusBadgeEl.classList.toggle('is-saved', saved);
      statusBadgeEl.classList.toggle('is-dirty', !saved);
    };

    const fillForm = () => {
      form.querySelectorAll('input[name], textarea[name]').forEach((field) => {
        field.value = pathGet(state, field.name) ?? '';
      });
    };

    const updateSummary = () => {
      document.querySelector('#summary-phone').textContent = state.business.phone;
      document.querySelector('#summary-hours').textContent = state.business.hours;
      document.querySelector('#summary-address').textContent = state.business.address;
      document.querySelector('#summary-home-title').textContent = state.home.heroTitle;
      document.querySelector('#summary-contact-body').textContent = state.contactPage.heroBody;
      document.querySelectorAll('[data-admin-preview]').forEach((img) => {
        const key = img.getAttribute('data-admin-preview');
        const src = state.assetSlots[key];
        if (src) img.src = src;
      });
    };

    const setStatus = (message, saved = true) => {
      statusEl.textContent = message;
      setSavedState(saved);
    };

    const persistDraft = (message = `자동 저장되었습니다. (${new Date().toLocaleString('ko-KR')})`) => {
      localStorage.setItem(DRAFT_KEY, JSON.stringify(state));
      setStatus(message, true);
    };

    const scheduleSave = () => {
      setStatus('입력한 내용을 저장하는 중입니다...', false);
      if (saveTimer) window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => persistDraft(), 500);
    };

    fillForm();
    updateSummary();
    setStatus(localStorage.getItem(DRAFT_KEY) ? '이 브라우저에 저장된 초안을 불러왔습니다.' : '기본값을 불러왔습니다.', true);

    form.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;
      pathSet(state, target.name, target.value);
      if (target.name === 'business.phone') {
        state.business.phoneHref = makePhoneHref(target.value);
      }
      updateSummary();
      scheduleSave();
    });

    document.querySelectorAll('[data-admin-file]').forEach((input) => {
      input.addEventListener('change', (event) => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLInputElement) || !target.files?.[0]) return;
        const file = target.files[0];
        const reader = new FileReader();
        reader.onload = () => {
          state.assetSlots[target.dataset.adminFile] = String(reader.result || '');
          updateSummary();
          persistDraft(`${file.name} 사진을 저장했습니다.`);
        };
        reader.readAsDataURL(file);
      });
    });

    document.querySelectorAll('[data-admin-clear]').forEach((button) => {
      button.addEventListener('click', (event) => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLButtonElement)) return;
        const key = target.dataset.adminClear;
        state.assetSlots[key] = defaults.assetSlots[key];
        const input = document.querySelector(`[data-admin-file="${key}"]`);
        if (input instanceof HTMLInputElement) input.value = '';
        updateSummary();
        persistDraft('기본 사진으로 되돌렸습니다.');
      });
    });

    document.querySelector('#save-draft')?.addEventListener('click', () => {
      if (saveTimer) window.clearTimeout(saveTimer);
      persistDraft(`지금 저장했습니다. (${new Date().toLocaleString('ko-KR')})`);
    });

    document.querySelector('#reset-draft')?.addEventListener('click', () => {
      if (saveTimer) window.clearTimeout(saveTimer);
      localStorage.removeItem(DRAFT_KEY);
      state = clone(defaults);
      fillForm();
      updateSummary();
      document.querySelectorAll('[data-admin-file]').forEach((input) => {
        if (input instanceof HTMLInputElement) input.value = '';
      });
      setStatus('저장된 초안을 지우고 처음 상태로 되돌렸습니다.', true);
    });

    document.querySelector('#export-draft')?.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'vine-admin-draft.json';
      link.click();
      URL.revokeObjectURL(url);
      setStatus('현재 초안을 JSON 파일로 내보냈습니다.', true);
    });

    const openPreview = (path) => window.open(`${path}?draft=1`, '_blank', 'noopener,noreferrer');
    document.querySelector('#open-home-preview')?.addEventListener('click', () => openPreview('/'));
    document.querySelector('#open-location-preview')?.addEventListener('click', () => openPreview('/location'));
    document.querySelector('#open-contact-preview')?.addEventListener('click', () => openPreview('/contact'));
  </script>
</Layout>
