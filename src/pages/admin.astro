---
import AdminActionBar from '../components/admin/AdminActionBar.astro';
import AdminGalleryManager from '../components/admin/AdminGalleryManager.astro';
import AdminImageSlots from '../components/admin/AdminImageSlots.astro';
import AdminSection from '../components/admin/AdminSection.astro';
import AdminTextFields from '../components/admin/AdminTextFields.astro';
import {
  adminBusinessFields,
  adminCopyFields,
  adminDefaults,
  adminDraftStorageKey,
  adminGalleryItems,
  adminImageSlots,
  adminLinkFields,
} from '../data/admin-schema';
import Layout from '../layouts/Layout.astro';

const adminBootstrap = {
  storageKey: adminDraftStorageKey,
  defaults: adminDefaults,
};
---

<Layout title="간편 관리자 | 바인퍼니처" description="바인퍼니처 운영자가 자주 바꾸는 정보만 안전하게 다루는 간편 관리자 MVP입니다.">
  <section class="section" style="background: var(--color-surface);">
    <div class="container admin-shell">
      <div class="card admin-hero-card">
        <p class="eyebrow">Simple Admin</p>
        <h1>쉽게 수정하는 바인퍼니처 관리자</h1>
        <p>
          이 화면에서는 <strong>전화번호, 운영시간, 주소, 외부 링크, 메인 문구, 대표 사진 3장, 갤러리 순서</strong>만 바꿉니다.
          어려운 설정은 숨기고, 자주 쓰는 항목만 남겼습니다.
        </p>

        <div class="admin-step-strip">
          <article class="admin-step-card">
            <strong>1. 내용 수정</strong>
            <p>자주 바꾸는 항목만 입력하면 자동 저장됩니다.</p>
          </article>
          <article class="admin-step-card">
            <strong>2. 미리보기 확인</strong>
            <p>버튼을 눌러 실제 페이지에서 초안을 확인합니다.</p>
          </article>
          <article class="admin-step-card">
            <strong>3. 사이트 반영 파일 내보내기</strong>
            <p>최종 확인 후 관리자가 적용할 JSON 파일을 저장합니다.</p>
          </article>
        </div>
      </div>

      <AdminActionBar />

      <div class="admin-grid">
        <form id="admin-form" class="admin-form" autocomplete="off">
          <AdminSection title="1. 매장 기본 정보" note="전화번호와 운영시간은 고객이 가장 자주 보는 정보입니다.">
            <AdminTextFields fields={adminBusinessFields} columns="grid-3" />
          </AdminSection>

          <AdminSection title="2. 외부 채널 링크" note="푸터와 문의/오시는 길 버튼에 연결되는 링크입니다.">
            <AdminTextFields fields={adminLinkFields} columns="stack" />
          </AdminSection>

          <AdminSection title="3. 메인/안내 문구" note="첫 화면과 주요 안내 페이지에서 보이는 핵심 소개 문구입니다.">
            <AdminTextFields fields={adminCopyFields} columns="stack" />
          </AdminSection>

          <AdminSection title="4. 대표 사진 3장" note="사진을 고르면 바로 이 화면과 미리보기에서 바뀝니다. 단, 업로드한 사진은 이 브라우저에서만 임시 저장됩니다.">
            <AdminImageSlots slots={adminImageSlots} />
          </AdminSection>

          <AdminSection title="5. 갤러리 순서 / 노출" note="드래그 대신 위/아래 버튼으로 순서를 바꾸고, 노출 여부를 켜고 끕니다.">
            <AdminGalleryManager items={adminGalleryItems} />
          </AdminSection>
        </form>

        <aside class="admin-side-column">
          <section class="card admin-summary-card">
            <h2>지금 바뀌는 내용</h2>
            <div class="admin-summary-block">
              <strong>마지막 저장 시각</strong>
              <p id="summary-updated-at">아직 저장 전</p>
            </div>
            <div class="admin-summary-block">
              <strong>대표 사진 반영 상태</strong>
              <p id="summary-assets">기본 사진만 사용 중</p>
            </div>
            <div class="admin-summary-block">
              <strong>전화번호</strong>
              <p id="summary-phone"></p>
            </div>
            <div class="admin-summary-block">
              <strong>운영시간</strong>
              <p id="summary-hours"></p>
            </div>
            <div class="admin-summary-block">
              <strong>주소</strong>
              <p id="summary-address"></p>
            </div>
            <div class="admin-summary-block">
              <strong>인스타그램</strong>
              <p id="summary-instagram"></p>
            </div>
            <div class="admin-summary-block">
              <strong>메인 제목</strong>
              <p id="summary-home-title"></p>
            </div>
            <div class="admin-summary-block">
              <strong>문의 안내문</strong>
              <p id="summary-contact-body"></p>
            </div>
            <div class="admin-summary-block">
              <strong>갤러리 노출 상태</strong>
              <p id="summary-gallery"></p>
            </div>
          </section>

          <section class="card admin-summary-card">
            <h2>간단 사용 팁</h2>
            <ol class="simple-list note">
              <li>먼저 전화번호와 운영시간부터 수정</li>
              <li>그다음 메인 제목과 소개문 확인</li>
              <li>외부 링크가 맞는지 꼭 확인</li>
              <li>갤러리는 위/아래 버튼으로 순서만 정리</li>
              <li>대표 사진 업로드는 미리보기용 임시 저장일 수 있으니 반영 파일 안내를 함께 확인</li>
              <li>추가 작업 열기 안의 <strong>사용설명서 열기</strong>로 한 장짜리 안내를 바로 볼 수 있습니다</li>
            </ol>
          </section>
        </aside>
      </div>
    </div>
  </section>

  <script id="admin-bootstrap" type="application/json" set:html={JSON.stringify(adminBootstrap)}></script>

  <script>
    import {
      buildPublishPayload,
      cloneValue,
      createEmptyDraft,
      normalizeGalleryItems,
      pathGet,
      pathSet,
      readDraftFromStorage,
      serializeDraft,
      stampDraft,
    } from '../lib/admin-draft';

    const bootstrap = JSON.parse(document.querySelector('#admin-bootstrap')?.textContent ?? '{}');
    const storageKey = bootstrap.storageKey;
    const defaults = createEmptyDraft(bootstrap.defaults);

    const form = document.querySelector('#admin-form');
    const galleryList = document.querySelector('#admin-gallery-list');
    const statusEl = document.querySelector('#admin-status');
    const statusBadgeEl = document.querySelector('#admin-status-badge');
    let saveTimer = null;

    let state = readDraftFromStorage(storageKey, defaults);

    const setSavedState = (saved) => {
      statusBadgeEl.textContent = saved ? '자동 저장됨' : '저장 중';
      statusBadgeEl.classList.toggle('is-saved', saved);
      statusBadgeEl.classList.toggle('is-dirty', !saved);
    };

    const setStatus = (message, saved = true) => {
      statusEl.textContent = message;
      setSavedState(saved);
    };

    const downloadJson = (filename, data) => {
      const blob = new Blob([data], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(url);
    };

    const persistDraft = (message = `자동 저장되었습니다. (${new Date().toLocaleString('ko-KR')})`) => {
      state = stampDraft(state);
      window.localStorage.setItem(storageKey, JSON.stringify(state));
      setStatus(message, true);
    };

    const scheduleSave = () => {
      setStatus('입력한 내용을 저장하는 중입니다...', false);
      if (saveTimer) window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(() => persistDraft(), 500);
    };

    const fillForm = () => {
      form.querySelectorAll('input[name], textarea[name]').forEach((field) => {
        field.value = pathGet(state, field.name) ?? '';
      });
    };

    const sortedGallery = () => normalizeGalleryItems(state.gallery, defaults.gallery);

    const formatSavedAt = (value) => {
      if (!value) return '아직 저장 전';
      const parsed = new Date(value);
      if (Number.isNaN(parsed.getTime())) return value;
      return parsed.toLocaleString('ko-KR');
    };

    const updateSummary = () => {
      const localOnlySlots = Object.entries(state.assetSlots)
        .filter(([, value]) => typeof value === 'string' && value.startsWith('data:'))
        .map(([key]) => key);

      document.querySelector('#summary-updated-at').textContent = formatSavedAt(state.updatedAt);
      document.querySelector('#summary-assets').textContent =
        localOnlySlots.length > 0
          ? `브라우저 임시 업로드 ${localOnlySlots.length}장 있음 → 초안 JSON 내보내기 후 npm run admin:extract-assets 필요`
          : '기본 사진 또는 실제 사이트 경로 사용 중';
      document.querySelector('#summary-phone').textContent = state.business.phone;
      document.querySelector('#summary-hours').textContent = state.business.hours;
      document.querySelector('#summary-address').textContent = state.business.address;
      document.querySelector('#summary-instagram').textContent = state.business.instagram;
      document.querySelector('#summary-home-title').textContent = state.home.heroTitle;
      document.querySelector('#summary-contact-body').textContent = state.contactPage.heroBody;

      const visibleCount = sortedGallery().filter((item) => item.visible).length;
      document.querySelector('#summary-gallery').textContent = `${visibleCount}장 노출 / 총 ${state.gallery.length}장 관리중`;

      document.querySelectorAll('[data-admin-preview]').forEach((img) => {
        const key = img.getAttribute('data-admin-preview');
        const src = state.assetSlots[key];
        if (src) img.src = src;
      });
    };

    const renderGalleryList = () => {
      state.gallery = sortedGallery();
      const orderMap = new Map(state.gallery.map((item) => [item.key, item]));
      const cards = Array.from(galleryList.querySelectorAll('[data-admin-gallery-item]'));

      cards
        .sort((a, b) => {
          const first = orderMap.get(a.getAttribute('data-admin-gallery-item'));
          const second = orderMap.get(b.getAttribute('data-admin-gallery-item'));
          return (first?.order ?? 0) - (second?.order ?? 0);
        })
        .forEach((card) => {
          const key = card.getAttribute('data-admin-gallery-item');
          const item = orderMap.get(key);
          if (!item) return;

          card.dataset.adminGalleryVisible = String(item.visible);
          card.classList.toggle('is-hidden', !item.visible);
          galleryList.appendChild(card);

          const label = card.querySelector(`[data-admin-gallery-order-label="${key}"]`);
          if (label) {
            const originalTitle = label.textContent.replace(/^\d+\.\s*/, '');
            label.textContent = `${item.order}. ${originalTitle}`;
          }

          const note = card.querySelector('.note');
          if (note) note.textContent = item.visible ? '현재 사이트에 보이는 사진' : '현재 사이트에서 숨겨진 사진';

          const toggleButton = card.querySelector('[data-admin-gallery-action="toggle"]');
          if (toggleButton instanceof HTMLButtonElement) {
            toggleButton.textContent = item.visible ? '숨기기' : '보이기';
          }
        });
    };

    const moveGalleryItem = (key, direction) => {
      const items = sortedGallery();
      const index = items.findIndex((item) => item.key === key);
      const targetIndex = index + direction;
      if (index < 0 || targetIndex < 0 || targetIndex >= items.length) return;
      [items[index], items[targetIndex]] = [items[targetIndex], items[index]];
      state.gallery = items.map((item, itemIndex) => ({ ...item, order: itemIndex + 1 }));
      renderGalleryList();
      updateSummary();
      persistDraft('갤러리 순서를 저장했습니다.');
    };

    const toggleGalleryItem = (key) => {
      state.gallery = sortedGallery().map((item) => (item.key === key ? { ...item, visible: !item.visible } : item));
      renderGalleryList();
      updateSummary();
      persistDraft('갤러리 노출 상태를 저장했습니다.');
    };

    fillForm();
    renderGalleryList();
    updateSummary();
    setStatus(window.localStorage.getItem(storageKey) ? '이 브라우저에 저장된 초안을 불러왔습니다.' : '기본값을 불러왔습니다.', true);

    form.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) return;
      pathSet(state, target.name, target.value);
      if (target.name === 'business.phone') {
        state.business.phoneHref = `tel:${String(target.value ?? '').replace(/[^0-9+]/g, '')}`;
      }
      updateSummary();
      scheduleSave();
    });

    galleryList.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const action = target.dataset.adminGalleryAction;
      const key = target.dataset.adminGalleryKey;
      if (!action || !key) return;
      if (action === 'up') moveGalleryItem(key, -1);
      if (action === 'down') moveGalleryItem(key, 1);
      if (action === 'toggle') toggleGalleryItem(key);
    });

    document.querySelectorAll('[data-admin-file]').forEach((input) => {
      input.addEventListener('change', (event) => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLInputElement) || !target.files?.[0]) return;
        const file = target.files[0];
        const reader = new FileReader();
        reader.onload = () => {
          state.assetSlots[target.dataset.adminFile] = String(reader.result || '');
          updateSummary();
          persistDraft(`${file.name} 사진을 저장했습니다. 이 사진은 현재 브라우저 초안에서만 보입니다.`);
        };
        reader.readAsDataURL(file);
      });
    });

    document.querySelectorAll('[data-admin-clear]').forEach((button) => {
      button.addEventListener('click', (event) => {
        const target = event.currentTarget;
        if (!(target instanceof HTMLButtonElement)) return;
        const key = target.dataset.adminClear;
        state.assetSlots[key] = defaults.assetSlots[key];
        const input = document.querySelector(`[data-admin-file="${key}"]`);
        if (input instanceof HTMLInputElement) input.value = '';
        updateSummary();
        persistDraft('기본 사진으로 되돌렸습니다.');
      });
    });

    document.querySelector('#save-draft')?.addEventListener('click', () => {
      if (saveTimer) window.clearTimeout(saveTimer);
      persistDraft(`지금 저장했습니다. (${new Date().toLocaleString('ko-KR')})`);
    });

    document.querySelector('#reset-draft')?.addEventListener('click', () => {
      if (saveTimer) window.clearTimeout(saveTimer);
      window.localStorage.removeItem(storageKey);
      state = cloneValue(defaults);
      fillForm();
      renderGalleryList();
      updateSummary();
      document.querySelectorAll('[data-admin-file]').forEach((input) => {
        if (input instanceof HTMLInputElement) input.value = '';
      });
      setStatus('저장된 초안을 지우고 처음 상태로 되돌렸습니다.', true);
    });

    document.querySelector('#export-draft')?.addEventListener('click', () => {
      downloadJson('vine-admin-draft.json', serializeDraft(state));
      setStatus('현재 초안을 JSON 파일로 내보냈습니다.', true);
    });

    document.querySelector('#export-publish')?.addEventListener('click', () => {
      const payload = buildPublishPayload(state, defaults);
      downloadJson('vine-admin-publish.json', JSON.stringify(payload, null, 2));

      if (payload.localOnlyAssetSlots.length > 0) {
        setStatus(`반영 파일을 저장했습니다. 다만 ${payload.localOnlyAssetSlots.join(', ')} 사진은 브라우저 임시 업로드라 수동 교체가 필요합니다.`, true);
        return;
      }

      setStatus('사이트 반영 파일을 저장했습니다.', true);
    });

    const openPreview = (path) => window.open(`${path}?draft=1`, '_blank', 'noopener,noreferrer');
    document.querySelector('#open-home-preview')?.addEventListener('click', () => openPreview('/'));
    document.querySelector('#open-location-preview')?.addEventListener('click', () => openPreview('/location'));
    document.querySelector('#open-contact-preview')?.addEventListener('click', () => openPreview('/contact'));
    document.querySelector('#open-admin-guide')?.addEventListener('click', () => window.open('/admin-guide', '_blank', 'noopener,noreferrer'));
  </script>
</Layout>
