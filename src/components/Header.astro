---
import { selectedAssets, siteMeta } from '../data/site';

const logoAsset = selectedAssets.logoPrimary;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteMeta.name} 홈으로 이동`}>
      {
        logoAsset.isRealAsset ? (
          <span class="brand-media brand-mark is-image">
            <img class="brand-logo" src={logoAsset.src} alt={logoAsset.alt} />
          </span>
        ) : (
          <span class="brand-media brand-mark" aria-hidden="true">VF</span>
        )
      }
      <span class="brand-text">{siteMeta.name}</span>
    </a>

    <a class="header-cta" href={siteMeta.place} target="_blank" rel="noreferrer" data-draft-href="business.place">방문 예약</a>
  </div>
</header>
