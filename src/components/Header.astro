---
import { navigationItems, selectedAssets, siteMeta } from '../data/site';

const { pathname } = Astro.url;
const logoAsset = selectedAssets.logoPrimary;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${siteMeta.name} 홈으로 이동`}>
      {
        logoAsset.isRealAsset ? (
          <span class="brand-media brand-mark is-image">
            <img class="brand-logo" src={logoAsset.src} alt={logoAsset.alt} />
          </span>
        ) : (
          <span class="brand-media brand-mark" aria-hidden="true">VF</span>
        )
      }
      <span class="brand-text">{siteMeta.name}</span>
    </a>

    <nav class="site-nav" aria-label="주요 메뉴">
      <ul>
        {navigationItems.map((item) => {
          const isActive = item.href === '/gallery'
            ? pathname === '/gallery'
            : item.href === '/brand'
              ? pathname === '/brand'
              : item.href === '/location'
                ? pathname === '/location'
                : item.href === '/contact'
                  ? pathname === '/contact'
                  : false;

          return (
            <li>
              <a href={item.href} class={isActive ? 'active' : ''}>{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>

    <a class="header-cta" href={siteMeta.phoneHref} data-draft-href="business.phoneHref">전화 문의하기</a>
  </div>
</header>
